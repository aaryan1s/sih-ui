# Required when DATA_BACKEND=supabase (auto-detected when both are set).
# Create a free project at https://supabase.com → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Publishable (anon) key ONLY — never the service-role key in frontend.
# RLS is the security boundary; the anon key grants no data access by itself.

# --- OCR provider (primary: local PaddleOCR service) ---
# When set, the New Inspection pipeline POSTs product images to this local
# Python/PaddleOCR service instead of using in-browser Tesseract.
#   1. Start the service:  cd ocr-service && uvicorn app:app --port 8100
#   2. Point the app at it:
VITE_OCR_ENDPOINT=http://localhost:8100/ocr
# When this variable is empty/absent, the app falls back to the built-in
# browser Tesseract.js provider (no Python needed). See ocr-service/README.md.
